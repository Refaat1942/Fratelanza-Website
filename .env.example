# Copy to .env on VPS before docker compose up

# Admin panel password (default if missing: Fratelanza2026)
ADMIN_PASSWORD=Fratelanza2026

# Email notifications — required for form alerts & weekly reports
NOTIFY_EMAIL=info@fratelanza.com

# SMTP settings (example: Hostinger / custom domain mail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@fratelanza.com
SMTP_PASS=your-email-password-here
SMTP_FROM="Fratelanza Website <info@fratelanza.com>"
